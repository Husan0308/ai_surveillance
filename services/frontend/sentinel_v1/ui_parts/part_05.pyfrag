        profile_layout = QVBoxLayout(profile_box)
        profile_layout.setContentsMargins(12, 12, 12, 12)
        profile_layout.addWidget(label("ASOSIY PROFIL RASMI", "eyebrow"), 0, Qt.AlignCenter)
        self.profile_preview = QLabel("Rasm tanlanmagan")
        self.profile_preview.setAlignment(Qt.AlignCenter)
        self.profile_preview.setFixedSize(170, 170)
        self.profile_preview.setStyleSheet(
            f"background:{C['field']};border:1px dashed {C['border']};border-radius:7px;color:{C['muted']};"
        )
        profile_layout.addWidget(self.profile_preview, 0, Qt.AlignCenter)
        self.profile_name = label("Yuz rasmlaridan birini belgilang", "muted")
        self.profile_name.setAlignment(Qt.AlignCenter)
        profile_layout.addWidget(self.profile_name)
        form_layout.addWidget(profile_box)

        self.count = label("Yuz rasmlari  0/10  ·  Asosiy rasm tanlanmagan", "muted")
        self.count.setStyleSheet(
            f"border:1px solid {C['border']};border-radius:5px;padding:10px;color:{C['muted']};"
        )
        form_layout.addWidget(self.count)
        self.finish_button = make_button("✓  Profilni yaratish", "primary")
        self.finish_button.clicked.connect(self.finish)
        form_layout.addWidget(self.finish_button)
        form_layout.addStretch()
        body.addWidget(form, 1)

        photos = Panel()
        photos_layout = panel_layout(photos, (18, 18, 18, 18), 10)
        photos_header = QHBoxLayout()
        header_text = QVBoxLayout()
        header_text.addWidget(label("Yuz tasvirlari", "sectionTitle"))
        header_text.addWidget(label("Shaxsning turli burchaklardan olingan 10 ta aniq rasmini yuklang.", "muted"))
        photos_header.addLayout(header_text)
        photos_header.addStretch()
        choose = make_button("＋  Rasmlarni tanlash", "primary")
        choose.clicked.connect(self.select_images)
        photos_header.addWidget(choose)
        photos_layout.addLayout(photos_header)

        self.photo_group = QButtonGroup(self)
        self.photo_group.setExclusive(True)
        self.photo_buttons: list[QPushButton] = []
        self.photo_labels: list[QLabel] = []
        grid = QGridLayout()
        grid.setSpacing(12)
        for index in range(10):
            cell = QVBoxLayout()
            tile = make_button("＋")
            tile.setCheckable(True)
            tile.setEnabled(False)
            tile.setMinimumSize(125, 112)
            tile.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
            tile.clicked.connect(lambda _, i=index: self.select_profile(i))
            self.photo_group.addButton(tile, index)
            self.photo_buttons.append(tile)
            cell.addWidget(tile)
            caption = label(f"Rasm {index + 1} · bo'sh", "mono")
            caption.setAlignment(Qt.AlignCenter)
            self.photo_labels.append(caption)
            cell.addWidget(caption)
            grid.addLayout(cell, index // 5, index % 5)
            grid.setColumnStretch(index % 5, 1)
        photos_layout.addLayout(grid)
        hint = label("Rasmlarni yuklagach, eng sifatli tasvirni asosiy profil rasmi sifatida belgilang.", "muted")
        hint.setWordWrap(True)
        photos_layout.addWidget(hint)
        photos_layout.addStretch()
        body.addWidget(photos, 3)
        self.layout.addLayout(body)
        self.layout.addStretch()

    def select_images(self):
        paths, _ = QFileDialog.getOpenFileNames(
            self,
            "10 ta yuz rasmini tanlang",
            "",
            "Images (*.png *.jpg *.jpeg *.webp *.bmp)",
        )
        if not paths:
            return
        if len(paths) != 10:
            QMessageBox.warning(self, "Rasmlar soni", "Aynan 10 ta rasm tanlash kerak.")
            return
        valid_paths = [path for path in paths if not QPixmap(path).isNull()]
        if len(valid_paths) != 10:
            QMessageBox.warning(self, "Noto'g'ri fayl", "Tanlangan fayllarning barchasi ochiladigan rasm bo'lishi kerak.")
            return
        self.image_paths = valid_paths
        self.profile_index = None
        self.profile_preview.clear()
        self.profile_preview.setText("Rasm tanlanmagan")
        self.profile_name.setText("Yuz rasmlaridan birini belgilang")
        for index, path in enumerate(self.image_paths):
            button = self.photo_buttons[index]
            button.setEnabled(True)
            button.setChecked(False)
            button.setText("")
            button.setIcon(QIcon(path))
            button.setIconSize(QSize(160, 104))
            button.setStyleSheet(f"border:1px solid {C['border']};border-radius:6px;padding:3px;")
            self.photo_labels[index].setText(f"Rasm {index + 1}")
        self.update_enrollment_status()

    def select_profile(self, index):
        if index >= len(self.image_paths):
            return
        self.profile_index = index
        for current, button in enumerate(self.photo_buttons):
            selected = current == index
            button.setChecked(selected)
            border = C['primary'] if selected else C['border']
            width = 3 if selected else 1
            button.setStyleSheet(f"border:{width}px solid {border};border-radius:6px;padding:3px;")
            self.photo_labels[current].setText(
                f"Rasm {current + 1} · ASOSIY" if selected else f"Rasm {current + 1}"
            )
            self.photo_labels[current].setStyleSheet(
                f"color:{C['primary'] if selected else C['muted']};font:10px 'DejaVu Sans Mono';"
            )
        pixmap = QPixmap(self.image_paths[index])
        self.profile_preview.setPixmap(
            pixmap.scaled(self.profile_preview.size(), Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
        )
        self.profile_name.setText(f"Rasm {index + 1} tanlandi")
        self.update_enrollment_status()

    def update_enrollment_status(self):
        profile = f"Rasm {self.profile_index + 1}" if self.profile_index is not None else "tanlanmagan"
        self.count.setText(f"Yuz rasmlari  {len(self.image_paths)}/10  ·  Asosiy rasm {profile}")

    def finish(self):
        if not self.name.text().strip():
            QMessageBox.warning(self, "Yangi profil", "Shaxsning to'liq ismini kiriting.")
            return
        if len(self.image_paths) != 10:
            QMessageBox.warning(self, "Yangi profil", "Profil yaratish uchun aynan 10 ta yuz rasmi kerak.")
            return
        if self.profile_index is None:
            QMessageBox.warning(self, "Yangi profil", "Eng yaxshi tasvirni asosiy profil rasmi sifatida belgilang.")
            return
        now = datetime.now().astimezone()
        person_name = self.name.text().strip()
        person = Person(
            id=next_person_id(),
            name=person_name,
            known=True,
            first_seen=now,
            last_seen=now,
            room_id=None,
            in_building=False,
            hue=sum(ord(character) for character in person_name) % 360,
            cameras=[],
            profile_image=self.image_paths[self.profile_index],
            note=self.note.toPlainText().strip(),
        )
        PEOPLE.append(person)
        QMessageBox.information(
            self,
            "Profil yaratildi",
            f"{person_name} Known shaxslar ro'yxatiga qo'shildi.",
        )
        self.enrolled.emit(person)


class EnrollmentDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.person: Person | None = None
        self.setWindowTitle("Yangi Known profil")
        self.resize(1240, 780)
        self.setMinimumSize(1050, 680)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        self.page = EnrollmentPage()
        self.page.enrolled.connect(self.complete)
        layout.addWidget(self.page)

    def complete(self, person: Person):
        self.person = person
        self.accept()


class CameraDialog(QDialog):
    def __init__(self, camera: Camera | None = None, parent=None):
        super().__init__(parent)
        self.camera = camera
        self.setWindowTitle("Kamerani tahrirlash" if camera else "Yangi kamera")
        self.setMinimumWidth(520)
        root = QVBoxLayout(self)
        root.setContentsMargins(22, 20, 22, 20)
        root.setSpacing(12)
        root.addWidget(label("Kamerani tahrirlash" if camera else "Yangi kamera qo'shish", "title"))
        root.addWidget(label("Kamera nomi, joylashuvi va RTSP ulanish ma'lumotlarini kiriting.", "muted"))

        form = Panel()
        grid = QGridLayout(form)
        grid.setContentsMargins(16, 16, 16, 16)
        grid.setHorizontalSpacing(14)
        grid.setVerticalSpacing(10)

        self.name = QLineEdit(camera.name if camera else "")
        self.name.setPlaceholderText("Masalan: Asosiy kirish")
        self.room = QLineEdit(room_name(camera.room_id) if camera else "")
        self.room.setPlaceholderText("Masalan: Lobbi yoki 2-qavat ofis")
        self.rtsp = QLineEdit(camera.rtsp if camera else "")
        self.rtsp.setPlaceholderText("rtsp://192.168.1.20:554/stream1")
        self.username = QLineEdit(camera.username if camera else "")
        self.username.setPlaceholderText("admin")
        self.password = QLineEdit(camera.password if camera else "")
        self.password.setEchoMode(QLineEdit.Password)
        self.password.setPlaceholderText("••••••••")
        self.enabled = QCheckBox("Kamera faol")
        self.enabled.setChecked(camera.enabled if camera else True)

        fields = [
            ("Kamera nomi *", self.name),
            ("Xona nomi *", self.room),
            ("RTSP URL *", self.rtsp),
            ("Login", self.username),
            ("Parol", self.password),
        ]
        for row, (caption, widget) in enumerate(fields):
            grid.addWidget(label(caption, "muted"), row, 0)
            grid.addWidget(widget, row, 1)
        options = QHBoxLayout()
        options.addWidget(self.enabled)
        options.addStretch()
        grid.addLayout(options, 5, 1)
        grid.setColumnStretch(1, 1)
        root.addWidget(form)

        buttons = QDialogButtonBox(QDialogButtonBox.Save | QDialogButtonBox.Cancel)
        buttons.button(QDialogButtonBox.Save).setText("Saqlash")
        buttons.button(QDialogButtonBox.Cancel).setText("Bekor qilish")
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        root.addWidget(buttons)

    def accept(self):
        name = self.name.text().strip()
        room = self.room.text().strip()
        rtsp = self.rtsp.text().strip()
        if not name:
            QMessageBox.warning(self, "Kamera nomi", "Kamera nomini kiriting.")
            self.name.setFocus()
            return
        if not room:
            QMessageBox.warning(self, "Xona nomi", "Kamera joylashgan xona nomini yozing.")
            self.room.setFocus()
            return
        if not rtsp.lower().startswith(("rtsp://", "rtsps://")):
            QMessageBox.warning(self, "RTSP URL", "Manzil rtsp:// yoki rtsps:// bilan boshlanishi kerak.")
            self.rtsp.setFocus()
            return
        duplicate = next((item for item in CAMERAS if item is not self.camera and item.rtsp == rtsp), None)
        if duplicate:
            QMessageBox.warning(self, "RTSP URL", f"Bu manzil {duplicate.name} kamerasida ishlatilgan.")
            self.rtsp.setFocus()
            return
        super().accept()

    def values(self) -> dict:
        room_text = self.room.text().strip()
        room_id = next(
            (item.id for item in ROOMS if room_text.casefold() in (item.id.casefold(), item.name.casefold())),
            room_text,
        )
        return {
            "name": self.name.text().strip(),
            "room_id": room_id,
            "rtsp": self.rtsp.text().strip(),
            "username": self.username.text().strip(),
            "password": self.password.text(),
            "enabled": self.enabled.isChecked(),
        }


class SettingsPage(ScrollPage):
    cameras_changed = Signal()

    def __init__(self):
        super().__init__()
        top = QHBoxLayout()
