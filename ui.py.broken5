        self.search = QLineEdit()
        self.search.setPlaceholderText("🔍 Search people…")
        self.search.setMaximumWidth(220)
        self.search.textChanged.connect(self.rebuild)

        enr = QPushButton("＋ Enroll New")
        enr.setObjectName("btnPrimary")
        enr.setCursor(Qt.PointingHandCursor)
        enr.clicked.connect(lambda: hub.navigate("enroll"))

        row.addWidget(self.search)
        row.addWidget(enr)

        self.tbl = QTableWidget(0, 6)

        self.tbl.setHorizontalHeaderLabels([
            "Photo",
            "Name",
            "Department",
            "Status",
            "Last Seen",
            "Recognitions",
        ])

        self.tbl.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        self.tbl.horizontalHeader().setSectionResizeMode(0, QHeaderView.ResizeToContents)

        self.tbl.verticalHeader().setVisible(False)

        self.tbl.setEditTriggers(QTableWidget.NoEditTriggers)
        self.tbl.setSelectionBehavior(QAbstractItemView.SelectRows)
        self.tbl.setShowGrid(False)
        self.tbl.setAlternatingRowColors(True)

        self.tbl.cellClicked.connect(self._profile)

        self.v.addWidget(self.tbl, 1)

        # Online/offline tracking
        self._online_persons = {}  # person_id -> {camera_id, track_id, name}
        
        # Signal ulash: IdentityManager dan online persons
        try:
            sm = self.hub.sys.sm
            if hasattr(sm, 'identity_manager') and sm.identity_manager:
                sm.identity_manager.persons_online.connect(self._on_persons_online)
                print("[PM] ✅ persons_online signal ulandi", flush=True)
        except Exception as e:
            print(f"[PM] ⚠ signal connect error: {e}", flush=True)
        
        self.rebuild()

    def _on_persons_online(self, camera_id, persons_list):
        """IdentityManager dan kelgan online persons"""
        for p in persons_list:
            pid = p.get("person_id")
            if pid is not None:
                self._online_persons[pid] = {
                    "camera_id": camera_id,
                    "track_id": p.get("track_id"),
                    "name": p.get("name", "Unknown"),
                    "known": p.get("known", False),
                }
        # Offline bo'lganlarni tozalash (bu kamerada ko'rinmayotganlar)
        cam_person_ids = {p.get("person_id") for p in persons_list if p.get("person_id")}
        to_remove = [pid for pid, info in self._online_persons.items() 
                     if info["camera_id"] == camera_id and pid not in cam_person_ids]
        for pid in to_remove:
            del self._online_persons[pid]
        
        # Jadvalni yangilash (faqat status ustunini)
        self._update_online_status()

    def _update_online_status(self):
        """Jadvalda online/offline statusni yangilash"""
        for row in range(self.tbl.rowCount()):
            name_item = self.tbl.item(row, 1)
            status_item = self.tbl.item(row, 3)
            if name_item is None or status_item is None:
                continue
            
            # person_id ni topish (name orqali)
            person_name = name_item.text()
            is_online = any(
                info["name"] == person_name or 
                (info["known"] and str(info.get("person_id","")) == person_name)
                for info in self._online_persons.values()
            )
            
            if is_online:
                status_item.setText("🟢 Online")
                status_item.setForeground(QColor("#2ecc71"))
            else:
                status_item.setText("⚫ Offline")
                status_item.setForeground(QColor("#95a5a6"))

    def rebuild(self):
        """Jadvalni to'liq qayta qurish — yuz + jonli status"""
        try:
            from datetime import datetime
            print(f"[PM] rebuild START", flush=True)

            self.tbl.clearContents()
            self.tbl.setRowCount(0)

            people = list(self.hub.sys.people)
            print(f"[PM] rebuild: {len(people)} people to display", flush=True)

            q = self.search.text().lower().strip() if hasattr(self, 'search') else ""
            sm = self.hub.sys.sm
            visible_count = 0

            # Backup image cache
            face_img_cache = {}
            try:
                with sm.db.lock:
                    rows = sm.db.conn.execute(
                        "SELECT person_id, image FROM face_embeddings "
                        "WHERE image IS NOT NULL AND length(image) > 0 "
                        "ORDER BY id DESC"
                    ).fetchall()
                for pid, img in rows:
                    if pid not in face_img_cache:
                        face_img_cache[pid] = img
            except Exception as e:
                print(f"[PM] face_img cache error: {e}", flush=True)

            for rec in people:
                if q:
                    # search_text = f"{rec.name} {rec.dept} {rec.emp_id}".lower()  # EMP REMOVED
                    if q not in search_text:
                        continue

                r = self.tbl.rowCount()
                self.tbl.insertRow(r)

                # ===== PHOTO =====
                ph = QTableWidgetItem()
                avatar_pm = None
                rec_id = getattr(rec, 'db_id', None)
                rec_name = getattr(rec, 'name', '?')

                # 1) PersonRecordUI dan avatar
                if hasattr(rec, 'avatar') and rec.avatar is not None and not rec.avatar.isNull():
                    avatar_pm = rec.avatar

                # 2) face_img_cache dan (face_embeddings.image)
                if avatar_pm is None and rec_id is not None:
                    img_bytes = face_img_cache.get(rec_id)
                    if img_bytes:
                        pm = QPixmap()
                        if pm.loadFromData(img_bytes):
                            avatar_pm = pm

                # 3) Name orqali cache dan qidirish (fallback)
                if avatar_pm is None:
                    for pid, img in face_img_cache.items():
                        # Barcha mavjud ID larni tekshirish
                        try:
                            pm = QPixmap()
                            if pm.loadFromData(img):
                                avatar_pm = pm
                                break  # birinchi topilgan rasm
                        except Exception:
                            continue

                if avatar_pm is not None:
                    scaled = avatar_pm.scaled(38, 38, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation)
                    ph.setData(Qt.DecorationRole, scaled)
                else:
                    # Xavfsiz name olish
                    p_name = (getattr(rec, 'name', None) or 
                              getattr(rec, 'person_name', None) or 
                              getattr(rec, 'emp_id', None) or "?")
                    try:
                        ph.setData(Qt.DecorationRole, make_avatar(p_name, 38))
                    except Exception:
                        ph.setData(Qt.DecorationRole, make_avatar("?", 38))

                ph.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 0, ph)

                # ===== NAME =====
                p_name = (getattr(rec, 'name', None) or getattr(rec, 'person_name', None) or "?")
                p_emp = (getattr(rec, 'emp_id', None) or getattr(rec, 'employee_id', None) or "")
                nm = QTableWidgetItem(f"{p_name}\n{p_emp}")
                nm.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 1, nm)

                # ===== DEPARTMENT =====
                dept_item = QTableWidgetItem(getattr(rec, 'dept', None) or getattr(rec, 'department', None) or "—")
                dept_item.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 2, dept_item)

                # ===== STATUS =====
                # Online/Offline status
                pid = getattr(rec, 'id', None) or getattr(rec, 'person_id', None)
                is_online = pid in self._online_persons if hasattr(self, '_online_persons') and pid else False
                if is_online:
                    status_text, status_color = "🟢 Online", "#2ecc71"
                else:
                    status_text, status_color = "⚫ Offline", "#95a5a6"
                st = QTableWidgetItem(status_text)
                st.setForeground(QColor(status_color))
                st.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 3, st)

                # ===== LAST SEEN =====
                ls_val = getattr(rec, 'last_seen', None) or getattr(rec, 'last_seen_dt', None)
                if ls_val and hasattr(ls_val, 'strftime'):
                    ls_text = ls_val.strftime("%d/%m/%Y %H:%M")
                elif ls_val:
                    ls_text = str(ls_val)[:16]
                else:
                    ls_text = "—"
                ls_item = QTableWidgetItem(ls_text)
                ls_item.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 4, ls_item)

                # ===== RECOGNITIONS =====
                rc = QTableWidgetItem(str(getattr(rec, 'rec_count', 0) or 0))
                rc.setTextAlignment(Qt.AlignCenter)
                rc.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 5, rc)

                self.tbl.setRowHeight(r, 50)
                visible_count += 1

            if hasattr(self, 'lbl_count'):
                self.lbl_count.setText(f"{visible_count} registered")

            print(f"[PM] rebuild DONE: {visible_count} rows displayed", flush=True)

            # Auto-refresh timer
            if not hasattr(self, '_presence_timer'):
                from PySide6.QtCore import QTimer
                self._presence_timer = QTimer(self)
                self._presence_timer.setInterval(20000)
                self._presence_timer.timeout.connect(self._auto_refresh_presence)
                self._presence_timer.start()

        except Exception as e:
            print(f"[PM] rebuild ERROR: {e}", flush=True)
            import traceback
            traceback.print_exc()

    def _presence_label(self, rec):
        """last_seen asosida jonli status matni va rangi"""
        from datetime import datetime
        if not rec.last_seen:
            return ("⚫ Never seen", TH.FAINT)
        try:
            secs = (datetime.now() - rec.last_seen).total_seconds()
        except Exception:
            return ("⚫ Unknown", TH.FAINT)

        if secs < 60:
            return ("🟢 Online", TH.OK)
        elif secs < 300:
            return (f"🟡 {int(secs // 60)}m ago", TH.WARN)
        elif secs < 86400:
            return (f"⚫ {int(secs // 3600)}h ago", TH.FAINT)
        else:
            return (f"⚫ {int(secs // 86400)}d ago", TH.FAINT)

    def _auto_refresh_presence(self):
        """Har 20s da faqat Status ustunini yangilash (tez, to'liq rebuild emas)"""
        try:
            for r in range(self.tbl.rowCount()):
                nm = self.tbl.item(r, 1)
                if not nm:
                    continue
                rec = nm.data(Qt.UserRole)
                if rec is None:
                    continue
                # Online/Offline status
                pid = getattr(rec, 'id', None) or getattr(rec, 'person_id', None)
                is_online = pid in self._online_persons if hasattr(self, '_online_persons') and pid else False
                if is_online:
                    status_text, status_color = "🟢 Online", "#2ecc71"
                else:
                    status_text, status_color = "⚫ Offline", "#95a5a6"
                st = QTableWidgetItem(status_text)
                st.setForeground(QColor(status_color))
                self.tbl.setItem(r, 3, st)
        except Exception:
            pass

    def add_record(self, rec):
        self.hub.sys.people.append(rec)

        self.rebuild()

    def _profile(self, r, c):
        """Istalgan ustunga bossa profil ochiladi"""
        rec = None

        # 1) Bosilgan ustundan UserRole olishga urinamiz
        it = self.tbl.item(r, c)
        if it:
            rec = it.data(Qt.UserRole)

        # 2) Bo'sh bo'lsa, Name ustunidan (1) olamiz
        if rec is None:
            name_it = self.tbl.item(r, 1)
            if name_it:
                rec = name_it.data(Qt.UserRole)

        # 3) Hali bo'sh bo'lsa, Photo ustunidan (0) olamiz
        if rec is None:
            photo_it = self.tbl.item(r, 0)
            if photo_it:
                rec = photo_it.data(Qt.UserRole)

        if rec is not None:
            sm = self.hub.sys.sm if hasattr(self.hub, 'sys') else None
            ProfileDialog(rec, sm=sm).exec()
        else:
            print(f"[PM] _profile: no rec found at row={r} col={c}", flush=True)

    def force_refresh(self):
        """Majburiy yangilash - DB dan qayta o'qish"""
        try:
            from backend.bridge.system_bridge import PersonRecordUI

            sm = self.hub.sys.sm
            people_data = sm.person_service.load_persons()
            
            # Agar odam soni o'zgarmagan bo'lsa, rebuild qilmaymiz
            if len(people_data) == len(getattr(self.hub.sys, 'people', [])):
                # Faqat online statusni yangilash
                self._update_online_status()
                return

            print(f"[PM] Loaded {len(people_data)} persons from DB", flush=True)

            # Face image cache ni oldindan yuklash
            _face_cache = {}
            try:
                with sm.db.lock:
                    _imgs = sm.db.conn.execute(
                        "SELECT person_id, image FROM face_embeddings "
                        "WHERE image IS NOT NULL AND length(image) > 0 "
                        "ORDER BY id DESC"
                    ).fetchall()
                for _pid, _img in _imgs:
                    if _pid not in _face_cache:
                        _face_cache[_pid] = _img
            except Exception as e:
                print(f"[PM] face cache preload error: {e}", flush=True)

            people_records = []
            for row in people_data:
                rec = PersonRecordUI(row, sm.person_service)
                # Agar avatar bo'sh bo'lsa, cache dan yuklash
                if (not hasattr(rec, 'avatar') or rec.avatar is None or rec.avatar.isNull()):
                    pid = row.get("id")
                    if pid in _face_cache:
                        pm = QPixmap()
                        if pm.loadFromData(_face_cache[pid]):
                            rec.avatar = pm
                people_records.append(rec)

            self.hub.sys.people = people_records

            print(f"[PM] hub.sys.people updated: {len(self.hub.sys.people)}", flush=True)

            self.rebuild()

            print(f"[PM] Table rebuilt: {self.tbl.rowCount()} rows", flush=True)

        except Exception as e:
            print(f"[PM] force_refresh error: {e}", flush=True)
            import traceback
            traceback.print_exc()

    def db_sync(self):
        """To'g'ridan-to'g'ri DB dan o'qib, jadvalni yangilash"""
        try:
            from datetime import datetime
            from backend.bridge.system_bridge import PersonRecordUI
            
            sm = self.hub.sys.sm
            
            # 1) Face image cache ni yuklash
            face_cache = {}
            try:
                with sm.db.lock:
                    imgs = sm.db.conn.execute(
                        "SELECT person_id, image FROM face_embeddings "
                        "WHERE image IS NOT NULL AND length(image) > 0 "
                        "ORDER BY id DESC"
                    ).fetchall()
                for pid, img in imgs:
                    if pid not in face_cache:
                        face_cache[pid] = img
            except Exception as e:
                print(f"[DB SYNC] face cache error: {e}", flush=True)
            
            # 2) Persons ni yuklash
            rows = sm.db.get_persons()
            print(f"[DB SYNC] DB returned {len(rows)} persons", flush=True)

            # Backup image cache
            face_img_cache = {}
            try:
                with sm.db.lock:
                    imgs = sm.db.conn.execute(
                        "SELECT person_id, image FROM face_embeddings "
                        "WHERE image IS NOT NULL AND length(image) > 0 "
                        "ORDER BY id DESC"
                    ).fetchall()
                for pid, img in imgs:
                    if pid not in face_img_cache:
                        face_img_cache[pid] = img
            except Exception:
                pass

            # Jadvalni tozalash
            self.tbl.clearContents()
            self.tbl.setRowCount(0)

            # Har bir qatorni qo'shish
            people_recs = []
            for row_data in rows:
                r = self.tbl.rowCount()
                self.tbl.insertRow(r)

                # Avatar: asl → backup → harf
                avatar_bytes = row_data.get("avatar") or b""
                if len(avatar_bytes) == 0:
                    avatar_bytes = face_img_cache.get(row_data["id"], b"")

                pm_avatar = QPixmap()
                has_avatar = False
                if avatar_bytes and len(avatar_bytes) > 0:
                    if pm_avatar.loadFromData(avatar_bytes):
                        has_avatar = True

                # Photo
                ph = QTableWidgetItem()
                if has_avatar:
                    ph.setData(Qt.DecorationRole, pm_avatar.scaled(
                        38, 38, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation
                    ))
                else:
                    ph.setData(Qt.DecorationRole, make_avatar(row_data["name"], 38))

                # Oddiy rec object (UserRole uchun)
                class _Rec:
                    pass
                rec = _Rec()
                rec.db_id = row_data["id"]
                rec.name = row_data.get("name", f"Unknown-{row_data['id']}")
                rec.dept = row_data.get("department", "")
                # rec.emp_id = row_data.get("employee_id", "")  # EMP REMOVED
                rec.status = row_data.get("status", "Active")
                rec.rec_count = int(row_data.get("rec_count", 0) or 0)
                rec.stay_total = int(row_data.get("stay_total", 0) or 0)
                rec.avatar = pm_avatar if has_avatar else make_avatar(rec.name, 96)
                rec.last_seen = None
                ls = row_data.get("last_seen")
                if ls:
                    try:
                        rec.last_seen = datetime.fromisoformat(ls)
                    except Exception:
                        pass
                rec.timeline = [0] * 24
                rec.visited = []
                rec.history = []

                ph.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 0, ph)

                # Name
                # p_name = (getattr(rec, 'name', None) or getattr(rec, 'person_name', None) or "?")
                p_emp = (getattr(rec, 'emp_id', None) or getattr(rec, 'employee_id', None) or "")
                p_name = (getattr(rec, "name", None) or getattr(rec, "person_name", None) or "?")
                p_emp = (getattr(rec, "emp_id", None) or getattr(rec, "employee_id", None) or "")
                nm = QTableWidgetItem(f"{p_name}\n{p_emp}")
                nm.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 1, nm)

                # Department
                dept_item = QTableWidgetItem(getattr(rec, 'dept', None) or getattr(rec, 'department', None) or "—")
                dept_item.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 2, dept_item)

                # Status (jonli)
                if rec.last_seen is None:
                    status_text, status_color = ("⚫ Never seen", TH.FAINT)
                else:
                    secs = (datetime.now() - rec.last_seen).total_seconds()
                    if secs < 60:
                        status_text, status_color = ("🟢 Online", TH.OK)
                    elif secs < 300:
                        status_text, status_color = (f"🟡 {int(secs // 60)}m ago", TH.WARN)
                    elif secs < 86400:
                        status_text, status_color = (f"⚫ {int(secs // 3600)}h ago", TH.FAINT)
                    else:
                        status_text, status_color = (f"⚫ {int(secs // 86400)}d ago", TH.FAINT)

                st = QTableWidgetItem(status_text)
                st.setForeground(QColor(status_color))
                st.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 3, st)

                # Last Seen
                ls_text = rec.last_seen.strftime("%d %b %H:%M") if rec.last_seen else "—"
                ls_item = QTableWidgetItem(ls_text)
                ls_item.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 4, ls_item)

                # Recognitions
                rc = QTableWidgetItem(str(getattr(rec, 'rec_count', 0) or 0))
                rc.setTextAlignment(Qt.AlignCenter)
                rc.setData(Qt.UserRole, rec)
                self.tbl.setItem(r, 5, rc)

                self.tbl.setRowHeight(r, 50)
                people_recs.append(rec)

            # hub.sys.people ni ham yangilash
            self.hub.sys.people = people_recs

            print(f"[DB SYNC] DONE: {self.tbl.rowCount()} rows", flush=True)
            self.hub.toast(f"✅ DB Sync: {self.tbl.rowCount()} employees")

        except Exception as e:
            print(f"[DB SYNC] ERROR: {e}", flush=True)
            import traceback
            traceback.print_exc()
            self.hub.toast(f"⚠ DB Sync error: {str(e)[:50]}")

class ProfileDialog(QDialog):
    def __init__(self, rec, sm=None):
        super().__init__()
        self.rec = rec
        self.sm = sm

        self.setWindowTitle(f"Profile — {rec.name}")
        self.setModal(True)
        self.resize(780, 720)

        # ===== OUTER LAYOUT: header + scroll + buttons =====
        outer = QVBoxLayout(self)
        outer.setContentsMargins(18, 18, 18, 18)
        outer.setSpacing(12)

        # ===== HEADER (FIXED — tepada) =====
        top = QHBoxLayout()
        top.setSpacing(14)

        av = QLabel()
        if hasattr(rec, 'avatar') and rec.avatar is not None and not rec.avatar.isNull():
            av.setPixmap(rec.avatar.scaled(84, 84, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
        else:
            av.setPixmap(make_avatar(rec.name, 84))
        av.setStyleSheet("border-radius:12px;")

        info = QVBoxLayout()
        nm = QLabel(rec.name)
        nm.setStyleSheet("font-size:17px; font-weight:800; color:white;")

        # Jonli status badge
        from datetime import datetime
        if rec.last_seen:
            try:
                secs = (datetime.now() - rec.last_seen).total_seconds()
            except Exception:
                secs = 999999
            if secs < 60:
                st_text, st_color = "🟢 Online", TH.OK
            elif secs < 300:
                st_text, st_color = f"🟡 {int(secs // 60)}m ago", TH.WARN
            else:
                st_text, st_color = "⚫ Offline", TH.FAINT
        else:
            st_text, st_color = "⚫ Never seen", TH.FAINT

        st = QLabel(st_text)
        st.setStyleSheet(f"color:{st_color}; font-size:11px; font-weight:700;")

        info.addWidget(nm)
        info.addWidget(st)
        info.addStretch(1)

        top.addWidget(av)
        top.addLayout(info)
        top.addStretch(1)
        outer.addLayout(top)

        # ===== SCROLL AREA (o'rtadagi barcha kontent) =====
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        scroll.setStyleSheet("QScrollArea{border:none; background:transparent;}")

        content = QWidget()
        v = QVBoxLayout(content)
        v.setContentsMargins(0, 0, 0, 0)
        v.setSpacing(12)

        # ===== STATS CARDS =====
        stats = QHBoxLayout()
        ls_text = rec.last_seen.strftime("%d %b %H:%M") if rec.last_seen else "—"

        for label, val in [
            ("LAST SEEN", ls_text),
            ("RECOGNITIONS", str(rec.rec_count)),
            ("STAY TOTAL", f"{rec.stay_total} min"),
        ]:
            f = QFrame()
            f.setObjectName("statCard")
            fl = QVBoxLayout(f)
            fl.setContentsMargins(10, 8, 10, 8)
            fl.setSpacing(2)
            a = QLabel(val)
            a.setStyleSheet("color:white; font-size:13px; font-weight:800;")
            b = QLabel(label)
            b.setStyleSheet(f"color:{TH.FAINT}; font-size:8px; font-weight:800;")
            fl.addWidget(a)
            fl.addWidget(b)
            stats.addWidget(f)

        v.addLayout(stats)

        # ===== VISIT HISTORY (DB dan) =====
        vc = ChartCard("VISIT HISTORY (last 7 days)")
        vv = QVBoxLayout()
        vv.setSpacing(4)

        visits_loaded = False
        if self.sm and hasattr(rec, 'db_id') and rec.db_id:
            try:
                visits = self.sm.db.get_visits(person_id=rec.db_id, limit=20)
                for vis in visits:
                    cam = vis.get("camera_id", "?")
                    entered = vis.get("entered_at", "?")
                    dur = vis.get("duration_sec", 0) or 0
                    dur_min = dur // 60
                    left = vis.get("left_at", "")
                    line = f"🎥 {cam}   ·   {str(entered)[:16]}   ·   {dur_min} min"
                    if left:
                        line += f"   → {str(left)[:16]}"
                    l = QLabel(line)
                    l.setStyleSheet(f"color:{TH.DIM}; font-size:10.5px;")
                    vv.addWidget(l)
                visits_loaded = len(visits) > 0
            except Exception as e:
                print(f"[Profile] visits error: {e}", flush=True)

        if not visits_loaded:
            l = QLabel("No visit records yet")
            l.setStyleSheet(f"color:{TH.FAINT}; font-size:10.5px; font-style:italic;")
            vv.addWidget(l)

        vc.body.addLayout(vv)
        v.addWidget(vc)

        # ===== EVENTS / ALERTS (DB dan) =====
        ec = ChartCard("RECENT EVENTS")
        ev = QVBoxLayout()
        ev.setSpacing(4)

        events_loaded = False
        if self.sm and hasattr(rec, 'db_id') and rec.db_id:
            try:
                events = self.sm.db.get_events_by_person(rec.db_id, limit=10)
                for evt in events:
                    t = evt.get("time", "?")
                    typ = evt.get("type", "?")
                    cam = evt.get("camera_id", "?")
                    conf = evt.get("confidence", 0)
                    level = evt.get("level", "info")
                    icon = "🔔" if level == "warn" else "✅" if level == "ok" else "ℹ"
                    line = f"{icon} {str(t)[:19]}  {typ}  [{cam}]  {conf:.0%}"
                    l = QLabel(line)
                    color = TH.WARN if level == "warn" else TH.OK if level == "ok" else TH.DIM
                    l.setStyleSheet(f"color:{color}; font-size:10.5px; font-family:Consolas,monospace;")
                    ev.addWidget(l)
                events_loaded = len(events) > 0
            except Exception as e:
                print(f"[Profile] events error: {e}", flush=True)

        if not events_loaded:
            l = QLabel("No events recorded yet")
            l.setStyleSheet(f"color:{TH.FAINT}; font-size:10.5px; font-style:italic;")
            ev.addWidget(l)

        ec.body.addLayout(ev)
        v.addWidget(ec)

        # ===== TIMELINE CHART (real-time) =====
        tl = ChartCard("TIMELINE (detections per hour - Today)")
        ch = BarChart()
        
        timeline_data = [0] * 24
        try:
            pid = getattr(rec, 'db_id', None) or getattr(rec, 'id', None)
            if pid and self.sm and hasattr(self.sm, 'person_service'):
                rt = self.sm.person_service._get_realtime_timeline(pid)
                if rt and len(rt) == 24:
                    timeline_data = rt
        except Exception as e:
            print(f"[Profile] timeline error: {e}", flush=True)
            timeline_data = getattr(rec, 'timeline', [0] * 24)
        
        ch.set_data(timeline_data, [f"{i:02d}" for i in range(24)], QColor("#3b82f6"),
                   formatter=lambda v: f"{int(v)}m" if v > 0 else "")
        ch._show_minutes = True
        ch.setMinimumHeight(90)
        tl.body.addWidget(ch)
        v.addWidget(tl)

        v.addStretch(1)

        scroll.setWidget(content)
        outer.addWidget(scroll, 1)

        # ===== BUTTONS (FIXED — pastda) =====
        btn_row = QHBoxLayout()
        btn_row.addStretch(1)

        edit_btn = QPushButton("✏ Edit")
        edit_btn.setObjectName("btnGhost")
        edit_btn.setCursor(Qt.PointingHandCursor)
        edit_btn.clicked.connect(self._edit_person)

        del_btn = QPushButton("🗑 Delete")
        del_btn.setObjectName("btnGhost")
        del_btn.setCursor(Qt.PointingHandCursor)
        del_btn.setStyleSheet(f"color:{TH.ERR};")
        del_btn.clicked.connect(self._delete_person)

        close_btn = QPushButton("Close")
        close_btn.setObjectName("btnPrimary")
        close_btn.setCursor(Qt.PointingHandCursor)
        close_btn.clicked.connect(self.accept)

        btn_row.addWidget(edit_btn)
        btn_row.addWidget(del_btn)
        btn_row.addWidget(close_btn)

        outer.addLayout(btn_row)

    def _edit_person(self):
        """Shaxsni tahrirlash dialog"""
        from PySide6.QtWidgets import QInputDialog

        sm = self.sm
        if not sm or not hasattr(self.rec, 'db_id') or not self.rec.db_id:
            return

        new_name, ok1 = QInputDialog.getText(self, "Edit Name", "Name:", text=self.rec.name)
        if not ok1 or not new_name.strip():
            return
        new_name = new_name.strip()

        new_dept, ok2 = QInputDialog.getText(self, "Edit Department", "Department:", text=getattr(self.rec, 'dept', ''))
        if not ok2:
            return
        new_dept = new_dept.strip()

        try:
            with sm.db.lock:
                sm.db.conn.execute(
                    "UPDATE persons SET name=?, department=?, updated_at=? WHERE id=?",
                    (new_name, new_dept, datetime.now().isoformat(), self.rec.db_id)
                )
                sm.db.conn.commit()
            print(f"[Edit] Updated person {self.rec.db_id}: {new_name}", flush=True)
            self.accept()
        except Exception as e:
            print(f"[Edit] ERROR: {e}", flush=True)

    def _delete_person(self):
        """Shaxsni o'chirish (tasdiqlash bilan)"""
        from PySide6.QtWidgets import QMessageBox

        sm = self.sm
        if not sm or not hasattr(self.rec, 'db_id') or not self.rec.db_id:
            return

        reply = QMessageBox.question(
            self, "Delete Person",
            f"Are you sure you want to delete '{self.rec.name}'?\n\n"
            "This will remove all records, embeddings, and visit history.",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )

        if reply != QMessageBox.Yes:
            return

        try:
            sm.db.delete_person(self.rec.db_id)
            print(f"[Delete] Deleted person {self.rec.db_id}: {self.rec.name}", flush=True)
            self.accept()
        except Exception as e:
            print(f"[Delete] ERROR: {e}", flush=True)


class EnrollmentPage(Page):
    def __init__(self, hub):
        super().__init__()

        self.hub = hub
        self.sim = hub.sys.enroll_sim

        self.title_row(
            "Person Enrollment",
            "auto face detection · 10 samples · embedding",
        )

        body = QHBoxLayout()
        body.setSpacing(12)

        # ==================== LEFT: CAMERA ====================
        left = QFrame()
        left.setObjectName("camCard")

        ll = QVBoxLayout(left)
        ll.setContentsMargins(0, 0, 0, 0)
        ll.setSpacing(0)

        self.surface = VideoSurface(self.sim, face_box=True)
        ll.addWidget(self.surface, 1)

        sbar = QFrame()
        sbar.setFixedHeight(36)
        sbar.setStyleSheet(
            f"background:{TH.CARD2}; border-top:1px solid {TH.BORDER};"
        )

        sh = QHBoxLayout(sbar)
        sh.setContentsMargins(12, 0, 12, 0)
        sh.setSpacing(10)

        self.face_status = QLabel("⏹ Camera off — press Camera ON")
        self.face_status.setStyleSheet(
            f"color:{TH.DIM}; font-size:10.5px; font-weight:700;"
        )

        hint = QLabel("Look straight, then slowly turn left/right during capture")
        hint.setStyleSheet(f"color:{TH.DIM}; font-size:9.5px;")

        # ✅ Camera ON/OFF tugmasi (sbar da)
        self.btn_cam = QPushButton("📷 Camera ON")
        self.btn_cam.setObjectName("btnGhost")
        self.btn_cam.setCursor(Qt.PointingHandCursor)
        self.btn_cam.clicked.connect(self.toggle_camera)

        sh.addWidget(self.face_status)
        sh.addStretch(1)
        sh.addWidget(self.btn_cam)       # ✅ cam_toggle emas, btn_cam
        sh.addWidget(hint)

        ll.addWidget(sbar)
        body.addWidget(left, 1)

        # ==================== RIGHT: FORM ====================
        right = QFrame()
        right.setObjectName("chartCard")
        right.setFixedWidth(350)

        f = QVBoxLayout(right)
        f.setContentsMargins(16, 16, 16, 16)
        f.setSpacing(10)

        t = QLabel("REGISTER NEW PERSON")
        t.setStyleSheet(
            f"color:{TH.ACC2}; font-size:9px; font-weight:800; letter-spacing:1.5px;"
        )
        f.addWidget(t)

        self.name = QLineEdit()
        self.name.setPlaceholderText("Full Name *")

        self.dept = QComboBox()
        self.dept.addItems([
            "Security", "IT", "Finance", "HR",
            "Operations", "Management", "Other",
        ])

        self.dept_custom = QLineEdit()
        self.dept_custom.setPlaceholderText("Other department name...")
        self.dept_custom.hide()
        self.dept.currentTextChanged.connect(self._on_dept_changed)

        # self.emp = QLineEdit()  # EMP REMOVED
        # self.emp.setPlaceholderText("Employee ID (auto if empty)")  # EMP REMOVED

        f.addWidget(self.name)
        f.addWidget(self.dept)
        f.addWidget(self.dept_custom)
        # f.addWidget(self.emp)  # EMP REMOVED

        self.prog = QProgressBar()
        self.prog.setRange(0, 10)
        self.prog.setValue(0)
        self.prog.setFixedHeight(8)
        self.prog.setTextVisible(False)

        self.prog_lbl = QLabel("Captured 0 / 10")
        self.prog_lbl.setStyleSheet(
            f"color:{TH.DIM}; font-size:10px; font-weight:700;"
        )

        f.addWidget(self.prog_lbl)
        f.addWidget(self.prog)

        self.thumbs = QGridLayout()
        self.thumbs.setSpacing(6)
        f.addLayout(self.thumbs)

        self.emb = QLabel("Embedding: —")
        self.emb.setStyleSheet(
            f"color:{TH.FAINT}; font-size:9.5px; font-family:Consolas,monospace;"
        )
        f.addWidget(self.emb)
        f.addStretch(1)

        # ✅ Tugmalar
        self.btn_cap = QPushButton("📸  Capture (10 samples)")
        self.btn_cap.setObjectName("btnGhost")
        self.btn_cap.setCursor(Qt.PointingHandCursor)
        self.btn_cap.clicked.connect(self.start_capture)

        self.btn_upload = QPushButton("📁 Upload Images")
        self.btn_upload.setObjectName("btnGhost")
        self.btn_upload.setCursor(Qt.PointingHandCursor)
        self.btn_upload.clicked.connect(self.upload_images)

        # ✅ btn_row SHU YERDA yaratiladi
        btn_row = QHBoxLayout()
        btn_row.setSpacing(8)
        btn_row.addWidget(self.btn_cap)
        btn_row.addWidget(self.btn_upload)

        self.btn_reg = QPushButton("💾  Register")
        self.btn_reg.setObjectName("btnPrimary")
        self.btn_reg.setEnabled(False)
        self.btn_reg.setCursor(Qt.PointingHandCursor)
        self.btn_reg.clicked.connect(self.register)

        f.addLayout(btn_row)
        f.addWidget(self.btn_reg)

        body.addWidget(right)
        self.v.addLayout(body, 1)

        self.captures = []

        self.cap_timer = QTimer()
        self.cap_timer.setInterval(3000)   # ✅ 3 sekund
        self.cap_timer.timeout.connect(self.capture_one)

    # ==================== CAMERA ON/OFF ====================
    def toggle_camera(self):
        if not hasattr(self, 'sim') or self.sim is None:
            return
        if self.sim.online:
            self.sim.online = False
            self.btn_cam.setText("📷 Camera ON")
            self.face_status.setText("⏹ Camera off")
            self.face_status.setStyleSheet(f"color:{TH.DIM}; font-size:10.5px; font-weight:700;")
        else:
            self.sim.online = True
            self.btn_cam.setText("📷 Camera OFF")
            self.face_status.setText("🟢 Camera on — face detection active")
            self.face_status.setStyleSheet(f"color:{TH.OK}; font-size:10.5px; font-weight:700;")

    def hideEvent(self, e):
        if hasattr(self, "cap_timer"):
            self.cap_timer.stop()
        super().hideEvent(e)

    # ==================== CAPTURE ====================
    def start_capture(self):
        # ✅ Kamerani yoqish
        if hasattr(self, 'sim') and self.sim is not None and not self.sim.online:
            self.sim.online = True
            self.btn_cam.setText("📷 Camera OFF")
            self.face_status.setText("🟢 Camera on — capturing…")
            self.face_status.setStyleSheet(f"color:{TH.OK}; font-size:10.5px; font-weight:700;")

        for i in reversed(range(self.thumbs.count())):
            w = self.thumbs.itemAt(i).widget()
            if w:
                w.deleteLater()

        self.captures = []
        self.prog.setValue(0)
        self.prog_lbl.setText("Captured 0 / 10")
        self.emb.setText("Embedding: —")
        self.btn_reg.setEnabled(False)
        self.btn_cap.setEnabled(False)
        self.btn_upload.setEnabled(True)
        self.face_status.setText("📸 Capturing samples…")
        self.cap_timer.start()

    def capture_one(self):
        # Kamera yonmasa, yoqish
        if hasattr(self, 'sim') and self.sim is not None and not self.sim.online:
            self.sim.online = True
            self.btn_cam.setText("📷 Camera OFF")

        # ✅ PORTRET CROP: yuz + bosh to'liq (soch tepasidan ko'krak boshigacha)
        crop = None
        fb = getattr(self.sim, '_face_bbox', None)

        if fb and self.sim.frame and len(fb) == 4:
            x1, y1, x2, y2 = fb
            face_w = max(1.0, x2 - x1)
            face_h = max(1.0, y2 - y1)
            cx = (x1 + x2) / 2.0

            img_w = self.sim.frame.width()
            img_h = self.sim.frame.height()

            # Portret proporsiyalari (rasmdagidek)
            top    = y1 - 0.70 * face_h   # soch / bosh tepasi
            bottom = y2 + 1.10 * face_h   # bo'yin + ko'krak boshi
            half_w = max(1.05 * face_w, (bottom - top) / 2.0)  # kvadrat portret
            left   = cx - half_w
            right  = cx + half_w

            # chegaralash
            left   = max(0, int(left))
            top    = max(0, int(top))
            right  = min(img_w, int(right))
            bottom = min(img_h, int(bottom))

            if right - left > 30 and bottom - top > 30:
                crop = self.sim.frame.copy(QRect(left, top, right - left, bottom - top))

        # Fallback: agar face topilmasa, eski mantiq
        if crop is None:
            p = self.sim.people[0] if self.sim.people else None
            if p and self.sim.frame:
                bb = p.bbox(FRAME_W, FRAME_H)
                hr = bb.height() * 0.105
                fr = QRect(
                    int(bb.center().x() - 2.2 * hr),
                    int(bb.top() - 0.5 * hr),
                    int(4.4 * hr),
                    int(5.0 * hr),
                )
                fr = fr.intersected(QRect(0, 0, FRAME_W, FRAME_H))
                crop = self.sim.frame.copy(fr)
            else:
                crop = (
                    self.sim.frame.copy()
                    if self.sim.frame
                    else QImage(64, 64, QImage.Format_RGB32)
                )

        pm = QPixmap.fromImage(crop)
        self.captures.append(pm)

        lb = QLabel()
        lb.setFixedSize(58, 58)
        lb.setPixmap(pm.scaled(58, 58, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))

        q = random.randint(82, 99)
        lb.setToolTip(f"Quality: {q}%")
        lb.setStyleSheet(f"border:2px solid {TH.OK if q > 90 else TH.WARN}; border-radius:6px;")

        self.thumbs.addWidget(lb, (len(self.captures) - 1) // 5, (len(self.captures) - 1) % 5)

        n = len(self.captures)
        self.prog.setValue(n)
        self.prog_lbl.setText(f"Captured {n} / 10")

        # ✅ 10 ta rasm → embedding hisoblash
        if n >= 10:
            self.cap_timer.stop()
            self.btn_cap.setEnabled(True)
            self.btn_upload.setEnabled(True)
            self._compute_embedding_from_captures()


    def _compute_embedding_from_captures(self):
        """Capture qilingan rasmlardan embedding hisoblash (xavfsiz konversiya)"""
        try:
            import cv2
            import numpy as np
            from PySide6.QtCore import QBuffer, QIODevice, QByteArray

            face_engine = self.hub.sys.sm.face_engine
            svc = self.hub.sys.sm.enrollment_service

            # ✅ QPixmap -> BGR (QByteArray orqali, asstring YO'Q)
            def _pm_to_bgr(pm):
                ba = QByteArray()
                buf = QBuffer(ba)
                buf.open(QIODevice.WriteOnly)
                pm.save(buf, "PNG")
                buf.close()
                arr = np.frombuffer(bytes(ba), dtype=np.uint8)
                return cv2.imdecode(arr, cv2.IMREAD_COLOR)

            bgr_images = []
            for pm in self.captures:
                bgr = _pm_to_bgr(pm)
                if bgr is not None:
                    bgr_images.append(bgr)

            if len(bgr_images) < 3:
                self.emb.setText(f"Embedding: {len(bgr_images)} faces (need ≥3)")
                self.emb.setStyleSheet(f"color:{TH.ERR}; font-size:9.5px; font-family:Consolas,monospace;")
                self.face_status.setText(f"⚠ Only {len(bgr_images)} valid faces")
                self.btn_reg.setEnabled(False)
                return

            embedding, score = face_engine.compute_embedding_from_images(bgr_images)

            if embedding is not None:
                hsh = embedding.tobytes().hex()[:12]
                self.emb.setText(f"Embedding: 512-d · {hsh}…  ✓")
                self.emb.setStyleSheet(f"color:{TH.OK}; font-size:9.5px; font-family:Consolas,monospace;")

                svc.current_embedding = embedding
                svc.current_embedding_score = float(score)
                svc.state = "ready"
                svc.captures_bgr = bgr_images

                self.face_status.setText(f"✅ {len(bgr_images)} samples — ready to register")
                self.btn_reg.setEnabled(True)
                print(f"[Enroll] ✅ Embedding OK score={score:.2f}", flush=True)
            else:
                self.emb.setText("Embedding: no valid faces found")
                self.emb.setStyleSheet(f"color:{TH.ERR}; font-size:9.5px; font-family:Consolas,monospace;")
                self.face_status.setText("⚠ No faces detected in captures")
                self.btn_reg.setEnabled(False)

        except Exception as e:
            import traceback
            traceback.print_exc()
            self.emb.setText(f"Embedding: error — {str(e)[:40]}")
            self.emb.setStyleSheet(f"color:{TH.ERR}; font-size:9.5px; font-family:Consolas,monospace;")
            self.face_status.setText(f"⚠ Error: {str(e)[:60]}")
            self.btn_reg.setEnabled(False)


    # ==================== UPLOAD ====================
    def upload_images(self):
        if hasattr(self, 'cap_timer') and self.cap_timer.isActive():
            self.cap_timer.stop()

        files, _ = QFileDialog.getOpenFileNames(
            self, "Select Face Images", "",
            "Images (*.png *.jpg *.jpeg *.bmp *.webp)"
        )

        if not files:
            return

        if len(files) > 10:
            self.hub.toast("⚠ Maximum 10 images. Using first 10.")
            files = files[:10]

        for i in reversed(range(self.thumbs.count())):
            w = self.thumbs.itemAt(i).widget()
            if w:
                w.deleteLater()

        self.captures = []
        self.prog.setValue(0)
        self.emb.setText("Embedding: processing...")
        self.btn_reg.setEnabled(False)
        self.btn_cap.setEnabled(False)
        self.face_status.setText("📁 Processing uploaded images...")

        import cv2
        import numpy as np

        valid_bgr = []
        valid_pm = []

        for fp in files:
            try:
                img = cv2.imread(fp)
                if img is None:
                    continue

                rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
                h, w, ch = rgb.shape
                qimg = QImage(rgb.data, w, h, ch * w, QImage.Format_RGB888).copy()
                pm = QPixmap.fromImage(qimg)

                lb = QLabel()
                lb.setFixedSize(58, 58)
                lb.setPixmap(pm.scaled(58, 58, Qt.KeepAspectRatioByExpanding, Qt.SmoothTransformation))
                lb.setStyleSheet(f"border:2px solid {TH.OK}; border-radius:6px;")
                lb.setToolTip(os.path.basename(fp))

                self.captures.append(pm)
                valid_pm.append(pm)
                valid_bgr.append(img)

                idx = len(self.captures) - 1
                self.thumbs.addWidget(lb, idx // 5, idx % 5)

            except Exception as e:
                print(f"[Upload] skip {fp}: {e}")

        self.prog.setValue(len(valid_bgr))
        self.prog_lbl.setText(f"Uploaded {len(valid_bgr)} / {len(files)}")

        if len(valid_bgr) < 3:
            self.face_status.setText(f"⚠ Only {len(valid_bgr)} valid images. Need ≥3.")
            self.btn_cap.setEnabled(True)
            self.btn_reg.setEnabled(False)
            return

        try:
            face_engine = self.hub.sys.sm.face_engine
            svc = self.hub.sys.sm.enrollment_service

            embedding, score = face_engine.compute_embedding_from_images(valid_bgr)

            if embedding is not None:
                hsh = embedding.tobytes().hex()[:12]
                self.emb.setText(f"Embedding: 512-d · {hsh}…  ✓")
                self.emb.setStyleSheet(f"color:{TH.OK}; font-size:9.5px; font-family:Consolas,monospace;")

                svc.current_embedding = embedding
                svc.current_embedding_score = float(score)
                svc.state = "ready"
                svc.captures_bgr = valid_bgr

                self.face_status.setText(f"✅ {len(valid_bgr)} images ready — press Register")
                self.btn_reg.setEnabled(True)
                self.btn_cap.setEnabled(True)
            else:
                self.emb.setText("Embedding: no valid faces found")
                self.emb.setStyleSheet(f"color:{TH.ERR}; font-size:9.5px; font-family:Consolas,monospace;")
                self.face_status.setText("⚠ No faces detected in uploaded images")
                self.btn_reg.setEnabled(False)
                self.btn_cap.setEnabled(True)

        except Exception as e:
            import traceback
            traceback.print_exc()
            self.emb.setText("Embedding: error")
            self.face_status.setText(f"⚠ Error: {str(e)[:60]}")
            self.btn_reg.setEnabled(False)
            self.btn_cap.setEnabled(True)

    # ==================== REGISTER ====================
    def register(self):
        name = self.name.text().strip()
        if not name:
            self.hub.toast("⚠ Please enter the person's name")
            self.name.setFocus()
            return

        svc = self.hub.sys.sm.enrollment_service

        if svc.state != "ready" or svc.current_embedding is None:
            self.hub.toast("⚠ Capture or upload images first")
            return

        dept = self.dept.currentText()
        if dept == "Other":
            dept = self.dept_custom.text().strip() or "Other"

        print(f"[Enroll] Calling register_person for {name}", flush=True)

        ok = svc.register_person(
            name=name,
            department=dept,
            # employee_id=self.emp.text().strip(),  # EMP REMOVED
        )

        if ok:
            print(f"[Enroll] register_person returned True", flush=True)

            from PySide6.QtCore import QTimer

            def _deferred_pm_update():
                try:
                    sm = self.hub.sys.sm
                    raw_rows = sm.db.get_persons()
                    print(f"[Enroll] DB returned {len(raw_rows)} persons", flush=True)

                    new_people = []
                    for row in raw_rows:
                        try:
                            rec = PersonRecordUI(row, sm.person_service)
                            new_people.append(rec)
                        except Exception:
                            pass

                    self.hub.sys.people = new_people

                    if hasattr(self.hub, 'pm'):
                        self.hub.pm.rebuild()

                except Exception as e:
                    print(f"[Enroll] Deferred PM update ERROR: {e}", flush=True)

            QTimer.singleShot(100, _deferred_pm_update)

            self.hub.toast(f"✅ {name} registered successfully")
            self._reset()
        else:
            self.hub.toast("⚠ Registration failed — check terminal logs")

    # ==================== RESET ====================
    def _reset(self):
        for i in reversed(range(self.thumbs.count())):
            w = self.thumbs.itemAt(i).widget()
            if w:
                w.deleteLater()

        self.captures = []
        self.prog.setValue(0)
        self.prog_lbl.setText("Captured 0 / 10")
        self.emb.setText("Embedding: —")
        self.emb.setStyleSheet(f"color:{TH.FAINT}; font-size:9.5px; font-family:Consolas,monospace;")
        self.btn_reg.setEnabled(False)
        self.name.clear()
        # self.emp.clear()  # EMP REMOVED
        self.face_status.setText("🟢 Ready for next enrollment")

    def _on_dept_changed(self, text):
        if text == "Other":
            self.dept_custom.show()
        else:
            self.dept_custom.hide()

            
class PasswordDialog(QDialog):
    def __init__(self, pwd, parent=None):
        super().__init__(parent)

        self.pwd = pwd

        self.setModal(True)
        self.setFixedWidth(380)

        v = QVBoxLayout(self)
        v.setContentsMargins(26, 26, 26, 22)
        v.setSpacing(10)

        ic = QLabel("🔒")
        ic.setStyleSheet("font-size:30px;")
        ic.setAlignment(Qt.AlignCenter)

        t = QLabel("Restricted Area")
        t.setAlignment(Qt.AlignCenter)
        t.setStyleSheet("font-size:15px; font-weight:800; color:white;")

        s = QLabel("Administrator password required")
        s.setAlignment(Qt.AlignCenter)
        s.setStyleSheet(f"color:{TH.DIM}; font-size:10.5px;")

        self.edit = QLineEdit()
        self.edit.setEchoMode(QLineEdit.Password)
        self.edit.setPlaceholderText("Password")
        self.edit.returnPressed.connect(self.check)

        self.err = QLabel("Incorrect password")
        self.err.setAlignment(Qt.AlignCenter)
        self.err.setStyleSheet(f"color:{TH.ERR}; font-size:10px;")
        self.err.hide()

        row = QHBoxLayout()

        cancel = QPushButton("Cancel")
        cancel.setObjectName("btnGhost")
        cancel.clicked.connect(self.reject)

        ok = QPushButton("Unlock")
        ok.setObjectName("btnPrimary")
        ok.clicked.connect(self.check)

        row.addStretch(1)
        row.addWidget(cancel)
        row.addWidget(ok)
        row.addStretch(1)

        for w in (ic, t, s, self.edit, self.err):
            v.addWidget(w)

        v.addLayout(row)

        self.edit.setFocus()

    def check(self):
        if self.edit.text() == self.pwd:
            self.accept()
        else:
            self.err.show()

            self.edit.clear()
            self.edit.setFocus()


class SettingsPage(Page):
    def __init__(self, hub):
        super().__init__()

        self.hub = hub

        self.title_row("Settings", "administrator access granted")

        self.tabs = QTabWidget()

        self.v.addWidget(self.tabs, 1)

        st = self.hub.sys.settings

        # Cameras
        w = QWidget()

        lay = QVBoxLayout(w)
        lay.setSpacing(8)

        for s in hub.sys.sims:
            row = QHBoxLayout()

            cb = QCheckBox(f"{s.id}  —  {s.name}")
            cb.setChecked(s.online)

            def mk(on=s, box=cb):
                def f(state):
                    on.online = box.isChecked()
                    on.render()

                    hub.sys.push_event(
                        dict(
                            type="online" if on.online else "offline",
                            level="ok" if on.online else "err",
                            cam=on.id,
                            person="Camera back online" if on.online else "Camera offline",
                            conf=1.0,
                        )
                    )

                return f

            cb.stateChanged.connect(mk())

            res = QComboBox()
            res.addItems(["1920×1080", "2560×1440", "1280×720"])

            fps = QSpinBox()
            fps.setRange(5, 60)
            fps.setValue(25)

            row.addWidget(cb, 1)
            row.addWidget(res)
            row.addWidget(fps)

            lay.addLayout(row)

        lay.addStretch(1)

        self.tabs.addTab(w, "🎥 Cameras")

        # AI
        w = QWidget()

        fm = QFormLayout(w)
        fm.setSpacing(12)

        model = QComboBox()
        model.addItems([
            "YOLOv11m-pose",
            "YOLOv11n-pose",
            "YOLOv8m-pose",
            "RTMPose-m",
        ])
        model.setCurrentText(st["model"])

        self.det = QSlider(Qt.Horizontal)
        self.det.setRange(10, 95)
        self.det.setValue(int(st["det_conf"] * 100))

        self.det_lbl = QLabel(f'{st["det_conf"]:.2f}')

        self.det.valueChanged.connect(lambda v: self.det_lbl.setText(f"{v / 100:.2f}"))

        dr = QHBoxLayout()
        dr.addWidget(self.det)
        dr.addWidget(self.det_lbl)

        dw = QWidget()
        dw.setLayout(dr)

        face = QCheckBox("Enable Face Recognition")
        face.setChecked(True)

        track = QSpinBox()
        track.setRange(10, 300)
        track.setValue(60)

        fm.addRow("Detection model", model)
        fm.addRow("Confidence threshold", dw)
        fm.addRow("", face)
        fm.addRow("Max track age (frames)", track)

        self.tabs.addTab(w, "🤖 AI")

        # Database
        w = QWidget()

        fm = QFormLayout(w)
        fm.setSpacing(12)

        fm.addRow("Path", QLineEdit("./data/surveillance.db"))
        fm.addRow("Size", QLabel("412 MB · 84,210 records"))

        br = QHBoxLayout()

        bb = QPushButton("Backup Now")
        bb.setObjectName("btnGhost")
        bb.clicked.connect(lambda: hub.toast("💾 Database backup started"))

        bv = QPushButton("Vacuum")
        bv.setObjectName("btnGhost")
        bv.clicked.connect(lambda: hub.toast("✅ Database optimized"))

        br.addWidget(bb)
        br.addWidget(bv)
        br.addStretch(1)

        fm.addRow("", br)

        self.tabs.addTab(w, "🗄 Database")

        # Performance
        w = QWidget()

        fm = QFormLayout(w)
        fm.setSpacing(12)

        gpu = QComboBox()
        gpu.addItems([
            "NVIDIA RTX 4070 (CUDA)",
            "NVIDIA GTX 1660 (CUDA)",
            "CPU only",
        ])

        thr = QSpinBox()
        thr.setRange(1, 16)
        thr.setValue(4)

        q = QSlider(Qt.Horizontal)
        q.setRange(1, 100)
        q.setValue(80)

        hw = QCheckBox("Hardware acceleration (NVDEC)")
        hw.setChecked(True)

        fm.addRow("GPU device", gpu)
        fm.addRow("Inference threads", thr)
        fm.addRow("Stream quality", q)
        fm.addRow("", hw)

        self.tabs.addTab(w, "⚡ Performance")

        # Recognition
        w = QWidget()

        fm = QFormLayout(w)
        fm.setSpacing(12)

        self.face_th = QSlider(Qt.Horizontal)
        self.face_th.setRange(30, 95)
        self.face_th.setValue(int(st["face_th"] * 100))

        self.face_th_lbl = QLabel(f'{st["face_th"]:.2f}')

        self.face_th.valueChanged.connect(
            lambda v: self.face_th_lbl.setText(f"{v / 100:.2f}")
        )

        fr = QHBoxLayout()
        fr.addWidget(self.face_th)
        fr.addWidget(self.face_th_lbl)

        fw = QWidget()
        fw.setLayout(fr)

        mf = QSpinBox()
        mf.setRange(20, 200)
        mf.setValue(60)

        ae = QCheckBox("Auto-enroll unknown after 5 detections")

        fm.addRow("Face match threshold", fw)
        fm.addRow("Min face size (px)", mf)
        fm.addRow("", ae)

        self.tabs.addTab(w, "🆔 Recognition")

        # Storage
        w = QWidget()

        fm = QFormLayout(w)
        fm.setSpacing(12)

        ret = QSpinBox()
        ret.setRange(1, 365)
        ret.setValue(st["retention"])

        ow = QCheckBox("Overwrite oldest recordings")
        ow.setChecked(True)

        disk = QProgressBar()
        disk.setRange(0, 100)
        disk.setValue(62)
        disk.setFixedHeight(10)

        fm.addRow("Retention (days)", ret)
