+def _verify_candidate_file(path: Path, expected: str, *, unavailable: str,
+                           mismatch: str) -> None:
+    try:
+        actual = hashlib.sha256(path.read_bytes()).hexdigest()
+    except OSError as exc:
+        raise RuntimeError(unavailable) from exc
+    if actual != expected:
+        raise RuntimeError(mismatch)
