+def test_worker_passes_isolated_fix6_command_and_project_root_to_fake_child(
+        tmp_path, monkeypatch):
+    _run_dir, report = _fake_run(tmp_path, monkeypatch)
+    child = tmp_path / 'capture_fix6_launcher_args.py'
+    marker = tmp_path / 'captured.json'
+    child.write_text(
+        'import json, pathlib, signal, sys, time\n'
+        f'marker = pathlib.Path({str(marker)!r})\n'
+        'marker.write_text(json.dumps({"env": {k: __import__("os").environ.get(k) '
+        'for k in ("SIX_LIVE_PROJECT_ROOT", "PYTHONPATH", '
+        '"SIX_LIVE_SUPPRESS_SHUTDOWN_PAUSE")}, "args": sys.argv[2:]}))\n'
+        'def mark(status):\n'
+        ' print("SIX_PIPELINE " + json.dumps({"status": status, '
+        '"monotonic_ns": time.monotonic_ns()}), flush=True)\n'
+        'signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))\n'
+        'mark("starting")\nmark("playing")\n'
+        'while True: time.sleep(.02)\n')
+    intended = module.launcher_cmd()
+    fake_command = [sys.executable, str(child), str(marker), *intended[3:]]
+    captured_env = {}
+    original_popen = subprocess.Popen
+
+    def child_factory(cmd, **kwargs):
+        captured_env.update(kwargs['env'])
+        return original_popen(cmd, **kwargs)
+
+    stop_event = threading.Event()
+    monkeypatch.setattr(module, 'gpu_snapshot', lambda: None)
+    monkeypatch.setattr(module, 'host_snapshot', lambda: None)
+    monkeypatch.setattr(module, 'stop_owned',
+                        lambda _report, _reason, owned, _identity:
+                        (owned.send_signal(signal.SIGTERM) or module.StopResult(0, 'fake_owned_child')))
+
+    def health(port, timeout=3):
+        del timeout
+        deadline = time.monotonic() + 2
+        while not marker.exists() and time.monotonic() < deadline:
+            time.sleep(.005)
+        if port == 8001:
+            stop_event.set()
+        return _good_health(port)
+
+    result = module.worker(
+        'fixture', preflight_fn=lambda: {'display': ':fixture', 'xauthority': '/tmp/fake'},
+        child_factory=child_factory, command_factory=lambda: fake_command,
+        health_fn=health, session_fn=lambda: (True, ':fixture', '/tmp/fake'),
+        cleanup_fn=lambda _pid, rc: {'launcher_reaped': rc == 0},
+        poll_interval=.005, sample_interval=.02, stop_event=stop_event,
+        install_signal_handlers=False)
+
+    captured = json.loads(marker.read_text())
+    args = captured['args']
+    assert result == 1  # A manual stop remains non-PASS.
+    assert captured['env']['SIX_LIVE_PROJECT_ROOT'] == str(module.ROOT)
+    assert str(module.ROOT) in captured['env']['PYTHONPATH'].split(os.pathsep)
+    assert captured['env']['SIX_LIVE_SUPPRESS_SHUTDOWN_PAUSE'] == '1'
+    assert '--upstream-progress-diagnostics' in args
+    assert '--source-stall-diagnostics' in args
+    assert '--mosaic-viewer-binary' in args
+    assert args[args.index('--mosaic-viewer-binary') + 1] == str(module.CANDIDATE)
+    final = _rows(report)[-1]
+    assert final['reason'] == 'manual_or_systemd_stop'
+    assert final['success'] is False
+
