+def test_real_transient_service_manual_stop_and_abnormal_exit(tmp_path):
+    unit = 'ai-surveillance-18m-manual-' + secrets.token_hex(4)
+    start = subprocess.run(['systemd-run', '--user', '--collect', f'--unit={unit}',
