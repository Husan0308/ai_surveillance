+        "systemd-run", "--user", "--collect", f"--unit={UNIT}", "--property=Type=exec",
+        "--property=Restart=no", "--property=KillMode=mixed",
+        f"--property=RuntimeMaxSec={remaining}s", f"--property=TimeoutStopSec={STOP}s",
