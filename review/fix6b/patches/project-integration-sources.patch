+             "xauthority": preflight_data["xauthority"], "start_mono": requested_mono,
+             "unit": UNIT, "candidate_sha256": EXPECTED,
+             "candidate_path": str(CANDIDATE),
+             "candidate_launcher_sha256": CANDIDATE_LAUNCHER_EXPECTED,
