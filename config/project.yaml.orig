# AI Surveillance configuration (optimized)
ai:
  detector:
    model: models/yolo26m.pt
    # Low-confidence boxes can recover an existing track, but cannot create
    # a new ID until tracker.new_track_thresh is reached.
    conf: 0.05
    iou: 0.45
    max_det: 50
    min_box_width: 3
    min_box_height: 6
    # Observed bottle false box: ~18x34. Small missed person: ~39x56.
    low_conf_size_threshold: 0.22
    low_conf_min_width: 12
    low_conf_min_height: 36
    device: cuda:0
    # GTX 1050 Ti benchmark: YOLO26m recovered 112/120 confirmed-person misses
    # at both requested sizes; 384x640 was substantially faster than 448x800.
    imgsz: [384, 640]
    half: false
  roi_recovery:
    discovery_interval_ms: 2000
    urgent_interval_ms: 1000
    max_task_age_ms: 500
  ai_fps: 10
  batch_size: 3
  batch_interval_ms: 40
  max_frame_age_ms: 120
  pose:
    conf: 0.20
    device: cpu
    # Deferred in P1: bbox bottom-center remains the heatmap position source.
    enabled: false
    imgsz: 320
    model: models/yolo26n-pose.pt
    batch_size: 6
    min_crop_width: 28
    min_crop_height: 60
  secondary:
    enabled: true
    queue_size: 36
  reid:
    # Associate an already detected person across cameras. This does not
    # fabricate boxes: every camera still requires a local YOLO detection.
    enabled: true
    deep_enabled: true
    # Rare async OSNet events are faster/more predictable on this CPU than
    # when contending with the latency-critical YOLO CUDA stream.
    device: cpu
    batch_size: 6
    batch_wait_ms: 5.0
    model: osnet_x0_25
    checkpoint: models/osnet_x0_25_market1501.pt
    threshold: 0.85
    ambiguous_threshold: 0.82
    # Cross-camera unknowns require both similarity and top-2 separation.
    unknown_threshold: 0.78
    unknown_margin: 0.04
    lost_memory_seconds: 4.0
    embedding_refresh_seconds: 10.0
    # At most one new/recovered/ambiguous ReID request per track in this window.
    event_cooldown_seconds: 5.0
    min_crop_height: 45
    min_crop_width: 20
    duplicate_iou: 0.65
    min_transition_seconds: 20
  reid_timeout_sec: 15
  tracker:
    match_thresh: 0.35
    new_track_thresh: 0.28
    # Conservative NEW-track admission only; existing confirmed people are never size-gated.
    new_track_min_width: 12
    new_track_min_height: 36
    new_track_min_area: 432
    new_track_min_aspect_ratio: 0.08
    new_track_max_aspect_ratio: 3.5
    track_buffer: 15   # 1.5 seconds at the measured 10 AI updates/second
    max_lost_time_ms: 1800
    # Expiry requires actual camera observations, never scheduler omission alone.
    min_expiry_misses: 3
    # Visual-only propagation; never counts as detector or identity evidence.
    prediction_horizon_ms: 1800
    effective_ai_fps: 10
    track_high_thresh: 0.22
    # 0.05-0.22 detections only recover tracks; new_track_thresh stays 0.28.
    track_low_thresh: 0.05
    # Three consistent frames hide chair/bottle one-frame false positives.
    min_confirmed_hits: 3
    tentative_buffer: 12
    confirmation_mean_thresh: 0.18
    type: custom_motion_iou
    visible_missing_frames: 5
enrollment:
  duplicate_threshold: 0.752
  images_count: 10
deepstream:
  enabled: true
  decoder_backend: nvv4l2decoder
  fallback_to_opencv: false   # avoid CPU fallback
  max_decode_streams: 16
face:
  det_size:
    - 320
    - 320
  # Code retained; disabled to reserve runtime for YOLO26m and OSNet.
  enabled: false
  device: cpu
  refresh_seconds: 60
  weak_retry_seconds: 3
  min_face_size: 30
  model: buffalo_l
  threshold: 0.4
heatmap:
  # Code retained; disabled to reserve runtime for YOLO26m and OSNet.
  enabled: false
  accumulation_mode: POINT
  grid_width: 160
  grid_height: 90
  kernel_radius: 4
  sigma: 2.0
  sample_interval_ms: 250
  live_decay_enabled: true
  live_decay_half_life_seconds: 30
  max_tracked_keys: 4096
logging:
  backup_count: 5
  dir: logs
  level: INFO
  max_mb: 10
performance:
  # Bound native pools so OpenCV/JPEG and CPU ReID do not each consume every core.
  opencv_threads: 2
  torch_threads: 4
  torch_interop_threads: 1
identity:
  # Two prompt, genuinely independent OSNet extractions are required before merge.
  min_independent_evidence_ms: 500
  initial_evidence_interval_seconds: 0.75
  # Low-quality crops remain eligible, but retry slowly so they cannot starve YOLO.
  low_quality_retry_seconds: 3.0
  max_embeddings_per_identity: 20
  max_activity_history: 256
  max_runtime_identities: 2000
  unknown_snapshots:
    max_identities: 500
    retention_days: 7
    min_improvement: 0.10
display:
  fps_cap: 18
  presentation_fps: 12
  prediction_fps: 15
  jpeg_quality: 85
  # Two-column cards do not consume 720p pixels. The real six-camera pacing
  # trace showed JPEG/decode/paint contention, so grid transport is capped at
  # 960x540. On-demand fullscreen is capped at 1280x720 so enlarging a camera
  # remains visibly sharper without encoding oversized frames.
  max_width: 960
  max_height: 540
  fullscreen_max_width: 1280
  fullscreen_max_height: 720
