# Optional camera URI overrides. Leave unset to use config/cameras.yaml defaults.
CAM_01_URI=rtsp://192.168.1.210:554/Streaming/Channels/101
CAM_02_URI=rtsp://192.168.1.210:554/Streaming/Channels/201
CAM_03_URI=rtsp://192.168.1.210:554/Streaming/Channels/301
CAM_04_URI=rtsp://192.168.1.210:554/Streaming/Channels/601
CAM_05_URI=rtsp://192.168.1.210:554/Streaming/Channels/502
CAM_06_URI=rtsp://192.168.1.210:554/Streaming/Channels/401

# RTSP auth is intentionally NOT enabled globally. If a camera actually needs
# URI credentials later, configure username_env/password_env for that camera.

ML_HOST=0.0.0.0
ML_PORT=8001
API_HOST=0.0.0.0
API_PORT=8000
CAMERA_CONFIG=config/cameras.yaml
FRAME_BUS_DIR=/dev/shm/ai_surveillance

ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_SECONDS=2.0

FRONTEND_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_REFRESH_INTERVAL_MS=2000
FRONTEND_FRAME_REFRESH_INTERVAL_MS=66
FRONTEND_FRAME_STALE_AFTER_MS=2000
