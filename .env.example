# Optional camera URI overrides. Defaults come from config/cameras.yaml.
CAM_01_URI=rtsp://192.168.1.210:554/Streaming/Channels/101
CAM_02_URI=rtsp://192.168.1.210:554/Streaming/Channels/201
CAM_03_URI=rtsp://192.168.1.210:554/Streaming/Channels/301
CAM_04_URI=rtsp://192.168.1.210:554/Streaming/Channels/601
CAM_05_URI=rtsp://192.168.1.210:554/Streaming/Channels/501
CAM_06_URI=rtsp://192.168.1.210:554/Streaming/Channels/401

# RTSP/NVR authentication. Prefer these global values when all six channels are
# served by the same recorder/account. .env is gitignored.
SURVEILLANCE_RTSP_USERNAME=
SURVEILLANCE_RTSP_PASSWORD=

# Optional per-camera overrides, e.g.:
# CAM_01_RTSP_USERNAME=
# CAM_01_RTSP_PASSWORD=

ML_HOST=0.0.0.0
ML_PORT=8001
API_HOST=0.0.0.0
API_PORT=8000
CAMERA_CONFIG=config/cameras.yaml

ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_SECONDS=4.0

FRONTEND_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_ML_VIDEO_BASE_URL=http://127.0.0.1:8001
FRONTEND_REFRESH_INTERVAL_MS=2000
FRONTEND_FRAME_REFRESH_INTERVAL_MS=33
